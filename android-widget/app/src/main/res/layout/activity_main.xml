<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- In-App Update Banner (Visible when newer APK is on GitHub) -->
        <LinearLayout
            android:id="@+id/update_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/widget_bg_cyber"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_update_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚀 Update verfügbar!"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_update_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Neue Features verfügbar. Bestehende Widgets bleiben erhalten."
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_install_update"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#10B981"
                android:text="⬇️ Update laden &amp; installieren"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_launcher_pig" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gamingpig Widget"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v2.0.0 · Homescreen Live-Anzeige"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary 1-Click Add Widget Button -->
        <Button
            android:id="@+id/btn_pin_widget"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#10B981"
            android:text="📲 Widget zum Homescreen hinzufügen"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_pin_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Mit 1 Klick erscheint das Widget direkt auf deinem Startbildschirm."
            android:textColor="#64748B"
            android:textSize="11sp" />

        <!-- Live Preview Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="LIVE VORSCHAU"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/preview_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="138dp"
            android:background="@drawable/widget_bg_liquid">

            <ImageView
                android:id="@+id/preview_bg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_launcher_pig" />

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/status_dot_live" />

                    <TextView
                        android:id="@+id/preview_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="GAMINGPIG IS LISTENING TO"
                        android:textColor="#38BDF8"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/preview_brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAMINGPIG"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/preview_cover"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/cover_placeholder"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_pig" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/preview_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Lade Live-Daten..."
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/preview_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Gamingpig"
                            android:textColor="#CBD5E1"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/preview_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/preview_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="45"
                    android:progressDrawable="@drawable/progress_bar_custom" />
            </LinearLayout>
        </FrameLayout>

        <!-- Theme Picker Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="DESIGN &amp; AMBIENT-MODUS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_theme_auto"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#0284C7"
                android:text="🌗 Auto"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_theme_ambient_blur"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.15"
                android:backgroundTint="#1E293B"
                android:text="🌫️ Cover Blur"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_theme_ambient_color"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.15"
                android:backgroundTint="#1E293B"
                android:text="🎨 Cover Farbe"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_theme_liquid"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="🌙 Dark Glass"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_theme_light"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="☀️ Light Glass"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_theme_oled"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="⬛ OLED Black"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_theme_cyber"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="⚡ Cyber Neon"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Text Size Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="TEXTGRÖSSE"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_size_small"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Klein"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_size_normal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#0284C7"
                android:text="Normal"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_size_large"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Groß"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Feature Switches -->
        <Switch
            android:id="@+id/switch_progress"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:text="Fortschrittsbalken anzeigen"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/switch_timeline"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:checked="true"
            android:text="Timeline-Zeit (z. B. 1:24 / 3:30) anzeigen"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/switch_recent"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:checked="false"
            android:text="„Zuletzt gehört“ im Widget anzeigen"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/switch_tap_spotify"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:checked="false"
            android:text="Tippen auf Song öffnet direkt Spotify"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_refresh_now"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="↻ Aktualisieren"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_open_web"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="🌐 Website öffnen"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="✓ Updates überschreiben diese App nahtlos – bestehende Homescreen-Widgets bleiben erhalten."
            android:textColor="#475569"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
