<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_launcher_pig" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gamingpig Widget"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Homescreen Live-Anzeige einrichten"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary 1-Click Add Widget Button -->
        <Button
            android:id="@+id/btn_pin_widget"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#10B981"
            android:text="📲 Widget zum Homescreen hinzufügen"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_pin_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Mit 1 Klick erscheint das Widget direkt auf deinem Startbildschirm."
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Live Preview Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="WIDGET VORSCHAU &amp; DESIGN"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/preview_box"
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:background="@drawable/widget_bg_liquid"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/status_dot_live" />

                <TextView
                    android:id="@+id/preview_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="NOW PLAYING"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/preview_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAMINGPIG"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/preview_cover"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/cover_placeholder"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_pig" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/preview_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Lade Live-Daten..."
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/preview_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Gamingpig"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/preview_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="45"
                android:progressDrawable="@drawable/progress_bar_custom" />
        </LinearLayout>

        <!-- Theme Picker Buttons (Row 1: Auto, Dark, Light) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="FARBE &amp; SYSTEM-MODUS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_theme_auto"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:backgroundTint="#0284C7"
                android:text="🌗 Auto (System)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_theme_liquid"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="🌙 Dark Glass"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_theme_light"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="☀️ Light Glass"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Theme Picker Buttons (Row 2: OLED, Cyber) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_theme_oled"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="⬛ OLED Black"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_theme_cyber"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="⚡ Cyber Neon"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Options -->
        <Switch
            android:id="@+id/switch_progress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Fortschrittsbalken anzeigen"
            android:textColor="#E2E8F0"
            android:textSize="14sp" />

        <!-- Refresh & Open Website -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_refresh_now"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="↻ Aktualisieren"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_open_web"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="🌐 Website öffnen"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
